# OsudSheba Web Environment Variables
# The website NEVER contains AppsPro secrets, webhook secrets, or AI tokens.
# All carrier billing and AI calls are handled securely by the authoritative backend.

# Primary Authoritative Backend URL (Node/Express on Render)
# Production: https://osudsheba.onrender.com
# Local fallback: http://localhost:3000 (Development only)
BACKEND_INTERNAL_URL=https://osudsheba.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://osudsheba.onrender.com
BACKEND_API_URL=https://osudsheba.onrender.com

# Optional: Configured public release download URL for production APK (e.g. S3 / Cloudflare R2 / GitHub Release)
# If unset in production, the download route notifies user that release is being provisioned.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=https://github.com/fahim0huq/osudsheba-web/releases/download/v1.0.0/OsudSheba-v1.0.0.apk
